# Application
APP_NAME="Smart Student Management"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Colombo

# Database (local XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_student_management
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Localhost PHP ↔ Flask attendance bridge (do not expose publicly)
INTERNAL_API_TOKEN=smartams-local-internal-api
PHP_INTERNAL_URL=http://127.0.0.1
PHP_CLI_PATH=C:\xampp\php\php.exe
ATTENDANCE_BRIDGE=cli
ATTENDANCE_CAMERA_ID=webcam-0
ATTENDANCE_CAMERA_MODE=ENTRY
# OpenCV camera index (one camera at a time). 0 = usually laptop, 1 = usually USB webcam
FACE_CAMERA_INDEX=0
EARLY_ARRIVAL_MINUTES=10
MIN_ATTENDANCE_PERCENT=75
LEFT_EARLY_TOLERANCE_MINUTES=5
POST_SESSION_EXIT_CAPTURE_MINUTES=10
