# Application
APP_NAME="Smart Student Management"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Colombo

# Database (local XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_student_management
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Localhost PHP ↔ Flask attendance bridge (do not expose publicly)
INTERNAL_API_TOKEN=smartams-local-internal-api
PHP_INTERNAL_URL=http://127.0.0.1
PHP_CLI_PATH=C:\xampp\php\php.exe
ATTENDANCE_BRIDGE=cli
ATTENDANCE_CAMERA_ID=webcam-0
